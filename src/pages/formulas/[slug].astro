---
import { getEmDashEntry, getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import { PortableText } from "astro-portabletext";

export async function getStaticPaths() {
	const { entries } = await getEmDashCollection("formulas");
	return entries.map((entry) => ({
		params: { slug: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;
---

<Base title={entry.data.title}>
  <article class="formula-detail">
    <div class="container hero">
      <div class="header">
        <h1>{entry.data.title}</h1>
        <p class="source">出处：{entry.data.source}</p>
      </div>

      <div class="content-wrapper">
        <section class="info-card">
          <h2>组成</h2>
          <div class="ingredients">{entry.data.ingredients}</div>
          <a href="/contact" class="btn btn-primary btn-lg">咨询采购</a>
        </section>

        <section class="indications">
          <h2>主治</h2>
          <div class="portable-text">
            <PortableText value={entry.data.indications} />
          </div>
        </section>
      </div>
    </div>
  </article>
</Base>

<style>
  .hero {
    padding: var(--spacing-5xl) var(--spacing-lg);
  }

  .header {
    margin-bottom: var(--spacing-4xl);
  }

  .header h1 {
    font-size: var(--font-size-6xl);
    margin-bottom: var(--spacing-xs);
  }

  .source {
    font-size: var(--font-size-xl);
    color: var(--color-muted);
    font-style: italic;
    margin-bottom: var(--spacing-lg);
  }

  .content-wrapper {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--spacing-4xl);
    align-items: start;
  }

  @media (max-width: 768px) {
    .content-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .info-card {
    background: var(--color-surface);
    padding: var(--spacing-2xl);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    position: sticky;
    top: calc(var(--spacing-md) + 64px);
  }

  .info-card h2 {
    margin-bottom: var(--spacing-md);
    font-size: var(--font-size-xl);
  }

  .ingredients {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: var(--spacing-xl);
    line-height: 1.4;
  }

  .indications h2 {
    margin-bottom: var(--spacing-xl);
  }

  .portable-text {
    font-size: var(--font-size-lg);
    line-height: 1.8;
  }
</style>
